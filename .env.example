# Copiez vers .env et renseignez vos identifiants Migros Online.
# Ne commitez jamais .env

MIGROS_EMAIL=vous@exemple.com
MIGROS_PASSWORD=votre-mot-de-passe
# Seed TOTP base32 (si 2FA activée) — pas le code à 6 chiffres
MIGROS_TOTP_SECRET=

# Cible du push — utilisez l'id OU le nom (pas les deux obligatoires)
# uv run python validate.py lists  → affiche les id numériques
MIGROS_SHOPPING_LIST_ID=
# Exemples : Les Avengers | Liste de Louis
MIGROS_SHOPPING_LIST_NAME=Liste de Louis

# Slug de la liste partagée (lien affiché après push, optionnel)
MIGROS_LIST_SLUG=4SOsOT53
